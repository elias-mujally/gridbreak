{
  "name": "gridbreak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "worker:typecheck": "tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev --port 8787",
    "worker:deploy": "wrangler deploy",
    "smoke:online": "node scripts/online-smoke.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.135.0",
    "ws": "^8.21.3"
  }
}
